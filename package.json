{
  "name": "momentos",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "codegen": "bash scripts/codegen.sh",
    "mobile": "pnpm --filter @momentos/mobile start",
    "phone": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-phone.ps1",
    "phone:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-phone.ps1 -Tunnel"
  },
  "devDependencies": {
    "turbo": "^2.11.9"
  }
}
