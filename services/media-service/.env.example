MEDIA_SERVICE_ADDR=:8082

# Postgres (Supabase connection string or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/momentos

# Supabase Storage (secret key — never ship to mobile)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
MEDIA_STORAGE_BUCKET=momentos-media

# Shared with gateway / moment-service / ml / render (moment-api trust model)
INTERNAL_SERVICE_TOKEN=dev-internal-token

# Migrations
MEDIA_AUTO_MIGRATE=true
# MEDIA_MIGRATIONS_DIR=/absolute/path/to/services/media-service/migrations
