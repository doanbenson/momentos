# Supabase (publishable/secret replace deprecated anon/service_role keys)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Gateway verifies ES256/RS256 via SUPABASE_URL/.../jwks.json.
# SUPABASE_JWT_SECRET is only needed for legacy HS256 tokens.
SUPABASE_JWT_SECRET=
# Optional; default authenticated
SUPABASE_JWT_AUD=authenticated

# Postgres (moment-service). Apply: psql "$DATABASE_URL" -f services/moment-service/migrations/001_init.sql
DATABASE_URL=postgres://postgres:postgres@localhost:5432/momentos?sslmode=disable

# Shared service-to-service token (gateway → peers; workers → moment-service)
INTERNAL_SERVICE_TOKEN=dev-internal-token

# Service URLs (local)
GATEWAY_URL=http://localhost:8080
GATEWAY_ADDR=:8080
MOMENT_SERVICE_URL=http://localhost:8081
MOMENT_SERVICE_ADDR=:8081
MEDIA_SERVICE_URL=http://localhost:8082
RENDER_SERVICE_URL=http://localhost:8083

# Jobs: Postgres SKIP LOCKED (ADR 0001). Optional lease override (seconds).
JOB_LEASE_SECONDS=300
# Dev only: skip media-service Asset ready/ownership checks when media is not up yet
MEDIA_SKIP_VALIDATE=false

# Render: absolute path recommended on Windows after winget install Gyan.FFmpeg
# RENDER_FFMPEG_PATH=C:\path\to\ffmpeg.exe
# RENDER_EDIT_AUDIO_PATH falls back to EDIT_AUDIO_PATH in scripts/dev-phone.ps1
MEDIA_STORAGE_BUCKET=momentos-media

# ML: metadata (default, fast) | gemini (per-photo multimodal; unused by Gemini placements today)
VISION_SCORING=metadata

# MVP Song Pick (mirrors apps/mobile/src/config/song-pick.ts)
SONG_PICK_ID=live-a-life-you-will-remember
SONG_PICK_TITLE=Live A Life You Will Remember
